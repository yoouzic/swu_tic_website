# Flask runtime
FLASK_ENV=development
FLASK_DEBUG=0
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000
SECRET_KEY=replace-with-a-long-random-secret

# Database
# Leave DATABASE_URL empty to use the local SQLite file below.
DATABASE_URL=
INSTANCE_DIR=data/instance
SQLITE_DB_PATH=data/instance/lecture_forms.db

# Uploads and generated files
UPLOAD_FOLDER=data/storage/uploads/general
MAX_CONTENT_LENGTH_MB=16
EXPORT_DIR=data/storage/exports/contacts

# Local business templates and default data files
CONTACT_TEMPLATE_PATH=data/storage/templates/contacts/通讯录.xlsx
SCHEDULE_TEMPLATE_PATH=data/storage/templates/schedule/全校课表.xls

# Auto-review default source files and generated reports
AUTO_REVIEW_UPLOAD_DIR=data/storage/uploads/auto_review
AUTO_REVIEW_REPORT_DIR=data/storage/exports/auto_review
AUTO_REVIEW_DEFAULT_SCHEDULE_PATH=data/storage/templates/auto_review/2025-2026-1课表.xlsx
AUTO_REVIEW_DEFAULT_CONTACTS_PATH=data/storage/templates/auto_review/第20届教学信息中心通讯录251016-审表信息版.xlsx
AUTO_REVIEW_DEFAULT_FEEDBACK_PATH=data/storage/templates/auto_review/办公部第7周反馈表-自动审表版.xlsx
AUTO_REVIEW_UPLOAD_RETENTION_DAYS=60
AUTO_REVIEW_UPLOAD_KEEP_PER_TYPE=3
AUTO_REVIEW_REPORT_RETENTION_DAYS=60
AUTO_REVIEW_REPORT_KEEP_COUNT=20
STORAGE_CLEANUP_ENABLED=1
STORAGE_CLEANUP_INTERVAL_HOURS=24

# Automated review worker
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=0
AUTOMATION_UPLOAD_DIR=data/storage/uploads/automation

# DeepSeek: complete forms are sent externally only after an administrator confirms a batch
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_ENABLED=1
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=3
DEEPSEEK_MAX_CONCURRENCY=4
DEEPSEEK_PROMPT_VERSION=2026-08-10-v1
